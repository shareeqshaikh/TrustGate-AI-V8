# Server Configuration
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=shareeqshaikh194@gmail.com
ADMIN_PASSWORD=adminPassword123
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# UPI Merchant Configuration
UPI_MERCHANT_ID=shareeqshaikh194@oksbi
UPI_MERCHANT_NAME=Shareeq Shaikh
PAYMENT_MODE=manual

# Refund Automation Configuration
AUTO_REFUND_MAX_PAISE=500
REFUND_WINDOW_DAYS=7

# Email Provider Configuration (dryrun | smtp | resend | gmail)
EMAIL_PROVIDER=dryrun
EMAIL_DRY_RUN=true
EMAIL_FROM=noreply@trustgate.ai
EMAIL_FROM_NAME=TrustGate AI

# Optional: SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password

# Optional: Resend API Key
EMAIL_API_KEY=

# Optional: Google OAuth for Gmail Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/email/oauth/callback
EMAIL_TOKEN_ENCRYPTION_KEY=

# Optional: Ollama AI Engine (Application works completely without Ollama)
OLLAMA_HOST=http://localhost:11434
REFUND_MODEL=llama3.2:1b
